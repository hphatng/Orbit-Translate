{
  "manifest_version": 3,
  "name": "Orbit Translate - Smart AI Translator & Vocabulary Booster",
  "version": "1.0.0",
  "description": "Selected-to-translate extension with IPA, context sentences, grammar breakdown, and SRS memory retention sync.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://orbit-translate.vercel.app/*",
      "https://*.vercel.app/*",
      "https://*.orbittranslate.ai/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Orbit Translate Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "orbit-translate@example.com",
      "strict_min_version": "109.0"
    }
  }
}
